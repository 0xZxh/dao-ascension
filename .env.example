# NEAR Network Environment (Development defaults to testnet)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEAR_RPC_TESTNET=https://rpc.testnet.near.org
NEAR_RPC_MAINNET=https://rpc.mainnet.near.org

# Optional: Custom NEAR Testnet Signer Account & Private Key (ed25519:...)
# If omitted, IntentWork generates an ephemeral deterministic testnet keypair and queries real testnet state
NEAR_TESTNET_ACCOUNT_ID=intentwork-treasury.testnet
NEAR_TESTNET_PRIVATE_KEY=

# NEAR Intents 1Click API Configuration
# Live API endpoint for real multi-chain token discovery and dry-run quotes
NEAR_INTENTS_API_BASE=https://1click.chaindefuser.com
# Optional JWT token from https://partners.near-intents.org/ (eliminates 0.25% unauthenticated fee)
NEAR_INTENTS_JWT=

# NEAR AI Cloud (TEE Verifiable Private Inference)
# Base URL defaults to https://cloud-api.near.ai/v1
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
# Optional API Key from https://cloud.near.ai (falls back to deterministic verifiable TEE sandbox if omitted)
NEAR_AI_API_KEY=
